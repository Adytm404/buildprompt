# Salin ke .env lalu sesuaikan.
# Endpoint AI OpenAI-compatible (harus menyertakan /v1).
VITE_AI_BASE_URL=http://localhost:20128/v1

# PENTING: API key ini ter-bundle ke sisi client (cukup untuk dev lokal).
# Untuk produksi, jangan taruh key di frontend — gunakan proxy backend.
VITE_AI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Model id yang dipakai untuk interview adaptif dan pembuatan PRD prompt.
VITE_AI_MODEL=cmc/deepseek/deepseek-v4.1-flash

# Target proxy dev Vite (opsional; default diambil dari origin VITE_AI_BASE_URL).
VITE_AI_PROXY_TARGET=http://localhost:20128

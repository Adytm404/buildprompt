# Salin ke .env lalu sesuaikan.

# ── Go API (Fiber) ────────────────────────────────────────
# Path yang dipakai browser. Di dev, Vite mem-proxy /api ke backend.
VITE_API_BASE_URL=/api

# Origin backend untuk proxy dev Vite (default http://localhost:8080).
VITE_API_PROXY_TARGET=http://localhost:8080

# ── Keamanan ──────────────────────────────────────────────
# Kunci AI (OpenAI-compatible) TIDAK BOLEH ditaruh di frontend.
# Semua pemanggilan model AI dilakukan server-side oleh backend Go.
# Konfigurasi kunci tersebut ada di: backend/.env (AI_BASE_URL, AI_API_KEY, AI_MODEL).
